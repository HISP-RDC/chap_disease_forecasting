# Variables read by compose.chap-disease-forecasting.yml. Append them to the
# .env file of the chap-core deployment directory (Compose reads it
# automatically). Never commit the resulting file.

# Immutable image published by CI: the sha-<7 chars> tag or, preferably,
# the digest printed in the CI job summary.
DISEASE_FORECASTING_IMAGE=ghcr.io/hisp-rdc/chap_disease_forecasting@sha256:TO_SET

# Required when chap sets CHAP_API_TOKEN, otherwise registration gets 401.
# Either reuse the token, or a dedicated key also passed to the chap container.
# SERVICEKIT_REGISTRATION_KEY=${CHAP_API_TOKEN}

# Reserve capacity for CHAP Core, its worker, PostgreSQL and Valkey.
DISEASE_FORECASTING_CPUS=4.0
DISEASE_FORECASTING_MEMORY=16g
DISEASE_FORECASTING_PIDS=512
DISEASE_FORECASTING_THREADS=4

# Docker log rotation for this container.
DISEASE_FORECASTING_LOG_MAX_SIZE=20m
DISEASE_FORECASTING_LOG_MAX_FILES=5
